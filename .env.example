# Copy to .env in the project root. Images are processed only in memory.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_TOKENS=384
YOLO_MODEL=yolo11n.pt
# Balanced small-object recall; use 640 for lower latency or 960 for more detail.
YOLO_IMAGE_SIZE=768
YOLO_CONFIDENCE=0.30
# CPU leaves GPU memory available for Qwen. Set 0 for a supported CUDA GPU.
YOLO_DEVICE=cpu
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: frontend uses the Vite /api proxy by default.
# VITE_API_URL=http://127.0.0.1:8000

